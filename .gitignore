# 依赖与构建产物
node_modules/
# 仅根目录 dist（管理端构建产物）；client/dist 是客户端 UI 源码，必须入库
/dist/
client/src-tauri/target/
client/node_modules/
backend/static/
# 签名私钥，绝不入库
backend/keys/
# 企微机器人等本地凭据，绝不入库
backend/.env
# 企微机器人本地配置，绝不入库
backend/wecom-bot.conf
__pycache__/
*.pyc
.venv/
venv/
tsconfig.tsbuildinfo

# 测试与输出产物
tests/last_results.json
tests/*.png
output/
release/
# tools/ 下为本地杂项；verify_sample 是第三方交付物须入库
tools/*
!tools/verify_sample/
# T5 库迁移脚本（运维执行，须入库）
!tools/migrate_license_hotel_id.py

# 系统文件
.DS_Store
Thumbs.db
.workbuddy/
backend/wecom-ws.lock

# 测试验收临时产物（含客户端 token/日志，不入库）
tests/client-accept/_online_dev.json
tests/client-accept/_realtime.txt
tests/client-accept/client-stderr.log
tests/client-accept/state.bin.bak
